{
  "manifest_version": 3,
  "name": "YouTube Recall - AI Micro-Learning Capture",
  "version": "1.1.0",
  "description": "Capture YouTube videos, link YouTube watch history, and generate AI smart transcripts (100% Free).",
  "permissions": [
    "storage",
    "activeTab",
    "history",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Recall"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
